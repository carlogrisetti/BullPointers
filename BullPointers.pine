//@version=6
indicator("BP", overlay = true)

// --- Session Display Input ---
sessionDisplay = input.string(
     title   = "Session Display",
     defval  = "Both",
     options = ["Chart Default", "Regular Only", "Extended Only", "Both"]
     )
// --- Helper Flags ---
showRegular  = sessionDisplay == "Both" or sessionDisplay == "Regular Only" or (sessionDisplay == "Chart Default" and syminfo.session == session.regular)
showExtended = sessionDisplay == "Both" or sessionDisplay == "Extended Only" or (sessionDisplay == "Chart Default" and syminfo.session != session.regular)

// --- Multi-Timeframe EMA Calculations on Regular session ---
tickerRegular = ticker.modify(syminfo.tickerid, session=session.regular)
regularEMA1T = request.security(tickerRegular, "1",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMA5T = request.security(tickerRegular, "5",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAHT = request.security(tickerRegular, "60", ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMADT = request.security(tickerRegular, "D",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAWT = request.security(tickerRegular, "W",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
regularEMAMT = request.security(tickerRegular, "M",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
plot(showRegular ? regularEMA1T : na, title = "1Tr", color = color.rgb(220, 178, 59), linewidth=3, force_overlay = true)
plot(showRegular ? regularEMA5T : na, title = "5Tr", color = color.rgb(52, 114, 171), linewidth=3, force_overlay = true)
plot(showRegular ? regularEMAHT : na, title = "HTr", color = color.rgb(162, 72, 255), linewidth=3, force_overlay = true)
plot(showRegular ? regularEMADT : na, title = "DTr", color = color.rgb(49, 27, 146), linewidth=3, force_overlay = true)
plot(showRegular ? regularEMAWT : na, title = "WTr", color = color.rgb(14, 179, 91), linewidth=3, force_overlay = true)
plot(showRegular ? regularEMAMT : na, title = "MTr", color = color.rgb(248, 121, 89), linewidth=3, force_overlay = true)

// --- Multi-Timeframe EMA Calculations on Extended session ---
tickerExtended = ticker.modify(syminfo.tickerid, session="24h")
extendedEMA1T = request.security(tickerExtended, "1",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMA5T = request.security(tickerExtended, "5",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAHT = request.security(tickerExtended, "60", ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMADT = request.security(tickerExtended, "D",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAWT = request.security(tickerExtended, "W",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
extendedEMAMT = request.security(tickerExtended, "M",  ta.ema(close, 27), lookahead = barmerge.lookahead_on)
plot(showExtended ? extendedEMA1T : na, title = "1Te", color = color.rgb(220, 178, 59), linewidth=2, force_overlay = true)
plot(showExtended ? extendedEMA5T : na, title = "5Te", color = color.rgb(52, 114, 171), linewidth=2, force_overlay = true)
plot(showExtended ? extendedEMAHT : na, title = "HTe", color = color.rgb(162, 72, 255), linewidth=2, force_overlay = true)
plot(showExtended ? extendedEMADT : na, title = "DTe", color = color.rgb(49, 27, 146), linewidth=2, force_overlay = true)
plot(showExtended ? extendedEMAWT : na, title = "WTe", color = color.rgb(14, 179, 91), linewidth=2, force_overlay = true)
plot(showExtended ? extendedEMAMT : na, title = "MTe", color = color.rgb(248, 121, 89), linewidth=2, force_overlay = true)
